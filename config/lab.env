# key-management-lab -- shared settings. Source this file: `source config/lab.env`
# DEMO VALUES ONLY. Never reuse these PINs anywhere real.
export LAB_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export RUN_DIR="$LAB_HOME/run"                      # all generated state (git-ignored)
export SOFTHSM2_CONF="$RUN_DIR/softhsm2.conf"       # SoftHSM reads its token directory from here
export PKCS11_MODULE="${PKCS11_MODULE:-/usr/lib/softhsm/libsofthsm2.so}"
export PKCS11_PROVIDER="${PKCS11_PROVIDER:-/usr/lib/x86_64-linux-gnu/ossl-modules/pkcs11.so}"
export SO_PIN="${SO_PIN:-87654321}"                 # Security Officer PIN (initialises tokens)
export USER_PIN="${USER_PIN:-123456}"               # Crypto User PIN (uses keys)
export PKI_DIR="$RUN_DIR/pki"
export OPENSSL_CONF="$RUN_DIR/openssl-pkcs11.cnf"   # loads the PKCS#11 provider for OpenSSL 3
export KMIP_DIR="$RUN_DIR/kmip"
export EXPORTER_PORT="${EXPORTER_PORT:-9105}"
