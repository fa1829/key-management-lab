{
  "uid": "kml-overview",
  "title": "Key Management Lab -- Crypto Estate",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Certificates expiring in < 15 days",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kml-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kml-prom"
          },
          "expr": "count(pki_cert_expiry_days < 15 and on(serial) pki_cert_revoked == 0) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Revoked certificates",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kml-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kml-prom"
          },
          "expr": "sum(pki_cert_revoked)",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HSM tokens online",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kml-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kml-prom"
          },
          "expr": "sum(hsm_token_present)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "KMIP server",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kml-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kml-prom"
          },
          "expr": "kmip_server_up",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Days until certificate expiry",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kml-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kml-prom"
          },
          "expr": "sort(pki_cert_expiry_days)",
          "legendFormat": "{{cn}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "min": 0,
          "max": 120,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "green",
                "value": 15
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Days until CRL must be republished",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kml-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kml-prom"
          },
          "expr": "pki_crl_next_update_days",
          "legendFormat": "{{ca}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Keys per HSM token",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "kml-prom"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kml-prom"
          },
          "expr": "hsm_token_keys",
          "format": "time_series",
          "instant": true,
          "refId": "A",
          "legendFormat": "{{token}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    }
  ],
  "tags": [
    "pki",
    "hsm",
    "kmip"
  ]
}